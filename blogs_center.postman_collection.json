              { "key": "X-Timestamp", "value": "{{timestamp}}", "type": "text" },
              { "key": "X-Signature", "value": "invalid-signature", "type": "text" }
            ],
            "url": { "raw": "{{baseUrl}}/api/blogs?application_id={{applicationId}}", "host": ["{{baseUrl}}"], "path": ["api", "blogs"], "query": [{ "key": "application_id", "value": "{{applicationId}}" }] }
          }
        }
