    { "key": "seriesId", "value": "" },
    { "key": "seriesBlogId1", "value": "" },
    { "key": "seriesBlogId2", "value": "" },
    { "key": "seriesBlogId3", "value": "" },
    { "key": "otherApplicationBlogId", "value": "" }
  ]
